# Servidor
PORT=3000
NODE_ENV=development
APP_URL=https://minhataxareal.com.br
ALLOWED_ORIGINS=https://minhataxareal.com.br,https://simulador.minhataxareal.com.br

# JWT
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria

# Contas especiais (master / demo)
MASTER_EMAIL=admin@minhataxareal.com.br
MASTER_PASS=troque_por_senha_segura
DEMO_PASS=troque_por_senha_segura

# Kiwify — webhook
KIWIFY_WEBHOOK_TOKEN=token_do_painel_kiwify

# Kiwify — product_ids (preencher após criar os produtos no Kiwify)
KIWIFY_PRODUCT_ATIVACAO_STANDARD=product_id_ativacao_standard_r4999
KIWIFY_PRODUCT_ASSINATURA_STANDARD=product_id_assinatura_standard_r1990
KIWIFY_PRODUCT_ATIVACAO_PREMIUM=product_id_ativacao_premium_r6990
KIWIFY_PRODUCT_ASSINATURA_PREMIUM=product_id_assinatura_premium_r3990

# E-mail (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
